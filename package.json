{
  "name": "puncher",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "cdk",
    "service",
    "ui"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev:api\" \"npm run dev:ui\"",
    "dev:api": "npm run dev --workspace=service",
    "dev:ui": "npm run dev --workspace=ui",
    "build:app": "npm exec --workspace=service -- tsc --noEmit -p ../tsconfig.json && npm run build --workspace=ui && npm run build --workspace=service",
    "build": "npm run build:app && npm run build --workspace=cdk",
    "test": "vitest run",
    "cdk:test": "npm run test --workspace=cdk",
    "test:browser": "playwright test",
    "test:db": "node --env-file-if-exists=.env --import tsx --test tests/dynamo.integration.ts",
    "db:init": "node --env-file-if-exists=.env --import tsx scripts/local-db.ts",
    "seed": "node --env-file-if-exists=.env --import tsx scripts/provision.ts seed",
    "provision": "node --env-file-if-exists=.env --import tsx scripts/provision.ts",
    "wallet:create-class": "node --env-file-if-exists=.env --import tsx scripts/create-google-class.ts",
    "cdk:synth": "npm run synth --workspace=cdk",
    "cdk:diff": "npm exec --workspace=cdk -- cdk diff",
    "cdk:deploy": "npm run deploy --workspace=cdk -- --all",
    "check": "npm run build && npm run cdk:synth && npm test",
    "format": "prettier --write \"{service,ui/src,scripts,cdk,tests}/**/*.{ts,tsx,mts,css,json}\" \"*.{json,ts}\"",
    "check:activity-contract": "node scripts/check-activity-contract.cjs",
    "cdk:synth:integration": "npm run synth:integration --workspace=cdk -- -c validation=true"
  },
  "dependencies": {
    "concurrently": "^10.0.6"
  }
}
