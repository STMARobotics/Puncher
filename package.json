{
  "name": "puncher",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k \"npm run dev:api\" \"npm run dev:ui\"",
    "dev:api": "node --env-file-if-exists=.env --import tsx service/local.ts",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && tsx scripts/bundle.ts",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:db": "node --env-file-if-exists=.env --import tsx --test tests/dynamo.integration.ts",
    "db:init": "node --env-file-if-exists=.env --import tsx scripts/local-db.ts",
    "seed": "node --env-file-if-exists=.env --import tsx scripts/provision.ts seed",
    "provision": "node --env-file-if-exists=.env --import tsx scripts/provision.ts",
    "import:dry-run": "node --import tsx scripts/import.ts",
    "cdk:synth": "cdk synth --app \"npx tsx infra/app.ts\"",
    "cdk:deploy": "cdk deploy --app \"npx tsx infra/app.ts\" --all",
    "check": "npm run build && npm run cdk:synth -- -c validation=true && npm test",
    "format": "prettier --write \"{service,ui/src,scripts,infra,tests}/**/*.{ts,tsx,css}\" \"*.{json,ts}\"",
    "check:activity-contract": "node scripts/check-activity-contract.cjs",
    "cdk:synth:integration": "cdk synth --app \"node --import tsx infra/integration-app.ts\" -c validation=true --output work/integration-synth"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1161.0",
    "@aws-sdk/lib-dynamodb": "^3.1161.0",
    "@fontsource/figtree": "^5.3.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "aws-cdk-lib": "^2.275.0",
    "constructs": "^10.8.1",
    "csv-parse": "^7.0.3",
    "google-auth-library": "^11.3.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "ajv": "^8.20.0",
    "aws-cdk": "^2.1147.0",
    "bwip-js": "^4.11.4",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
